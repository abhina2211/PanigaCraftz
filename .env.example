# Copy this file to .env (same folder) and fill in the key. .env is never committed.
# Both values are on Supabase: Project Settings > API (or "Connect" > App frameworks).
#
# The anon (public) key is meant to be used in browsers: Row Level Security in
# supabase/schema.sql limits it to reading products and submitting enquiries.
# NEVER put the service_role key here or anywhere in this project.
PUBLIC_SUPABASE_URL=https://fjjbrmvgnlwxpkusixoc.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Set to true to show the "launching soon" page instead of the shop (REQ-S10).
PUBLIC_COMING_SOON=
