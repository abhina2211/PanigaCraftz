---
/* Home page. Sections that don't change between visits (categories, Instagram
   strip, form options) are written into the HTML here at build time. The
   interactive parts (carousel, shop filters, quick view, hamper builder, custom
   order form) are filled in by src/scripts/home.js in the browser. */
import Base from '../layouts/Base.astro';
import { SHOP_CATEGORIES, OCCASIONS, FESTIVALS, IG_STRIP } from '../data/catalogue.js';
import { pic } from '../lib/pictures.js';
import { COMING_SOON } from '../lib/launch.js';

/* Before the shop opens, the home page is the launching-soon page (REQ-S10). */
if (COMING_SOON) return Astro.rewrite('/coming-soon/');

const igPost = (id, kind = 'p') => `https://www.instagram.com/${kind}/${id}/`;
const catPhoto = { planters: '/images/planters/CX__oHHB4Pj.jpg', candles: '/images/products/candle-1.jpg' };
const catPic = { candles: ['#f8e4e4', '#c0403a'], tealights: ['#f3e6dc', '#6e1f24'], vases: ['#f8e4e4', '#c0403a'], jars: ['#f3e6dc', '#c0403a'], decor: ['#e3eaf5', '#c0403a'], hampers: ['#f8e4e4', '#6e1f24'] };
const occasionOptions = [
  ...OCCASIONS.map(o => o.name),
  ...Object.values(FESTIVALS).filter(f => !OCCASIONS.some(o => o.name.startsWith(f.name))).map(f => f.name),
  'Wedding or engagement', 'Other'
];
const festButtons = [['auto', 'Auto (by date)'], ...Object.entries(FESTIVALS).map(([id, f]) => [id, f.name])];
---
<Base>

<section class="band hero" aria-roledescription="carousel" aria-label="Featured">
  <div class="wrap">
    <div class="slides" id="slides"></div>
    <div class="ctrl"><button id="prev" aria-label="Previous slide">‹</button><div class="dots" id="dots"></div><button id="next" aria-label="Next slide">›</button></div>
  </div>
</section>

<section class="band order-strip" id="how"><div class="wrap">
  <div><span class="hand">No payment online yet</span><h2>How ordering works</h2><p class="lead">Build a list here, send it to Neha, and she confirms stock, price and delivery with you.</p></div>
  <div class="steps">
    <div class="step"><h3>Pick your pieces</h3><p>Use Quick view to check details and add a name, packaging or gift note.</p></div>
    <div class="step"><h3>Copy your list</h3><p>We turn your enquiry list into a ready-to-send message. Nothing is charged yet.</p></div>
    <div class="step"><h3>Send it on Instagram</h3><p>Paste it into a DM to @panigacraftz_neha, or send it from the list. We confirm stock, total and timing.</p></div>
    <div class="step"><h3>Pick up or delivery</h3><p>Collect in Sydney or have it posted Australia-wide. New Zealand on request.</p></div>
  </div>
</div></section>

<section class="band" id="categories"><div class="wrap">
  <span class="hand">Pick a range</span><h2>Shop by category</h2>
  <p class="lead">Seven handmade ranges. Tap one to see what's in it.</p>
  <div class="cats" id="cats">
    {SHOP_CATEGORIES.map(c => (
      <a class="cat" href={`/#${c.id}`} data-cat={c.id}>
        <span class="cat-img">{catPhoto[c.id] ? <img src={catPhoto[c.id]} alt="" loading="lazy" /> : <Fragment set:html={pic(c.id, ...catPic[c.id])} />}</span>
        <b>{c.name}</b><small>{c.blurb}</small>
      </a>
    ))}
  </div>
</div></section>

<section class="band" id="recent" style="background:var(--soft)"><div class="wrap">
  <div class="row-head"><div><span class="hand">Fresh from the studio</span><h2>New pieces</h2><p class="lead">Fresh from Neha's table, the latest pieces she's made.</p></div><a class="btn ghost" href="#shop">View all</a></div>
  <div class="rail" id="rail"></div>
</div></section>

<section class="band occ" id="yearend"><div class="wrap">
  <div>
    <span class="hand">End of year gift guide</span><h2>Year-end gifts for the teachers who helped them grow</h2>
    <p class="lead">Personalised candles, mini planters and pamper hampers, boxed and ready to give. Also perfect for Kris Kringle.</p>
    <p style="margin-top:22px"><button class="btn light" data-occ="teacher">Shop teacher gifts</button></p>
  </div>
  <div class="feature">
    <img src="/images/products/candle-2.jpg" alt="The botanical candle in its clear gift box with a satin bow">
    <div>
      <h3>Teacher thank-you candle</h3>
      <ul><li>Hand-decoupaged leaf and blossom design</li><li>Gift box, ribbon and thank-you tag included</li><li>Add the teacher's name, or order 3 or 5 for class reps</li></ul>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap"><span class="price">$22</span><button class="btn" data-quick="c1">Quick view</button></div>
    </div>
  </div>
</div></section>

<section class="band" id="shop"><div class="wrap">
  <div class="row-head"><div><span class="hand">The shop</span><h2 id="shopTitle">All handmade pieces</h2><p class="lead" id="shopLead"></p></div></div>
  <div class="chips" id="filter" role="group" aria-label="Filter by category"></div>
  <div class="chips sub" id="subfilter" role="group" aria-label="Filter hampers or occasions"></div>
  <div class="tools">
    <label>Price<br><select id="priceBand"><option value="">Any price</option><option value="0-40">Under $40</option><option value="40-80">$40 to $80</option><option value="80-9999">$80 and over</option></select></label>
    <label>Sort<br><select id="sort"><option value="featured">Featured</option><option value="new">Newest</option><option value="low">Price, low to high</option><option value="high">Price, high to low</option></select></label>
  </div>
  <div class="grid" id="grid"></div>
  <p class="note">Draft: names come from Neha's Instagram posts. Prices are placeholders (except the Rose Mummy &amp; Baby set) and drawn pictures stand in until real photos are added. Corporate hampers are suggestions.</p>
</div></section>

<section class="band builder" id="build"><div class="wrap">
  <div class="row-head"><div><span class="hand">Make it yours</span><h2>Build your own hamper</h2><p class="lead" id="hbLead">Pick pieces that are in stock right now. The size follows how many you pick, and each size comes in its own basket with wrapping and a card.</p></div></div>
  <div class="hb">
    <div class="hb-list" id="hbItems" aria-label="Pieces you can add"></div>
    <div class="hb-sum" aria-live="polite">
      <h3>Your hamper</h3>
      <ol class="hb-sizes" id="hbSizes" aria-label="Hamper sizes"></ol>
      <p class="hb-size-msg" id="hbSizeMsg"></p>
      <ul id="hbChosen"></ul>
      <div class="totals"><div><span>Pieces</span><span id="hbPieces">0</span></div><div><span id="hbBasketLabel">Basket</span><span id="hbBasket"></span></div><div><span>Wrapping and card</span><span id="hbWrap"></span></div><div class="grand"><span>Hamper price</span><span id="hbTotal"></span></div></div>
      <div class="pers">
        <label>Packaging<select id="hbPack"></select></label>
        <label>Card message <span class="hint" id="hbNoteCount"></span><textarea id="hbNote" rows="2" placeholder="Happy birthday from all of us!"></textarea></label>
      </div>
      <p class="err" id="hbErr" hidden></p>
      <button class="btn" id="hbAdd" style="width:100%;margin-top:12px">Add hamper to enquiry</button>
      <p class="note">Need something that isn't in stock? Use the custom order form below and we'll make it for you.</p>
    </div>
  </div>
</div></section>

<section class="band custom" id="custom"><div class="wrap">
  <div>
    <span class="hand">Made for you</span><h2>Custom, corporate and bulk orders</h2>
    <p class="lead">A naming ceremony, table numbers for a party, client gifts for your team, or ten teacher gifts for one class? Three quick steps and we'll come back with a quote.</p>
    <p class="lead">Please allow at least 7 days for custom pieces.</p>
  </div>
  <div class="wizard" id="wizard">
    <div class="prog" aria-hidden="true"><i><b></b></i><i><b></b></i><i><b></b></i></div>
    <p class="steplabel" id="stepLabel">Step 1 of 3: What you need</p>
    <form id="coForm" novalidate>
      <fieldset class="co-step" data-step="1" style="border:0;padding:0;margin:0;display:grid;gap:14px">
        <legend class="sr" style="position:absolute;left:-9999px">What you need</legend>
        <div class="types" role="radiogroup" aria-label="Type of order">
          <label><input type="radio" name="type" value="Custom hamper">Custom hamper</label>
          <label><input type="radio" name="type" value="Corporate gifts">Corporate gifts</label>
          <label><input type="radio" name="type" value="Personalised piece">Personalised piece</label>
          <label><input type="radio" name="type" value="Event or party">Event or party</label>
        </div>
        <span class="err" data-for="type" hidden>Choose what you need.</span>
        <div class="two"><label>Occasion<select name="occasion" id="coOcc">{occasionOptions.map(o => <option>{o}</option>)}</select></label><label>Quantity<input name="qty" type="number" min="1" max="500" value="1" inputmode="numeric"></label></div>
        <span class="err" data-for="qty" hidden>Enter a quantity from 1 to 500.</span>
        <label>Budget per item<select name="budget"><option value="">Choose a budget</option><option>Under $40</option><option>$40 to $80</option><option>$80 to $150</option><option>$150 and over</option></select></label>
        <span class="err" data-for="budget" hidden>Choose a budget.</span>
      </fieldset>
      <fieldset class="co-step" data-step="2" hidden style="border:0;padding:0;margin:0;display:grid;gap:14px">
        <label>Tell us about it<textarea name="details" rows="4" placeholder="Colours, names, theme, what to include, e.g. pastel pink, names on tags: Ms Lee, Mr Patel"></textarea></label>
        <span class="err" data-for="details" hidden>Add a few more details (at least 15 characters).</span>
        <label>Needed by<input name="date" type="date"></label>
        <span class="err" data-for="date" hidden>Choose a date at least 7 days from today.</span>
      </fieldset>
      <fieldset class="co-step" data-step="3" hidden style="border:0;padding:0;margin:0;display:grid;gap:14px">
        <div class="two"><label>Your name<input name="name" autocomplete="name"></label><label>Email<input name="email" type="email" autocomplete="email"></label></div>
        <span class="err" data-for="name" hidden>Enter your name.</span><span class="err" data-for="email" hidden>Enter a valid email.</span>
        <div class="two"><label>Mobile (optional)<input name="phone" type="tel" autocomplete="tel" placeholder="04xx xxx xxx"></label><label>Postcode<input name="postcode" inputmode="numeric" maxlength="4" autocomplete="postal-code"></label></div>
        <span class="err" data-for="phone" hidden>Enter an Australian mobile, e.g. 0412 345 678.</span><span class="err" data-for="postcode" hidden>Enter a 4-digit postcode.</span>
        <label class="check"><input type="checkbox" name="consent">I'm happy for PanigaCraftz to contact me about this order.</label>
        <span class="err" data-for="consent" hidden>Please tick to continue.</span>
      </fieldset>
      <div class="wnav" id="coNav"><button type="button" class="btn ghost" id="coBack" style="visibility:hidden">Back</button><button type="submit" class="btn" id="coNext">Continue</button></div>
    </form>
    <div class="done" id="coDone" hidden>
      <p class="steplabel">Request ready</p>
      <p class="ref" id="coRef"></p>
      <p class="lead" style="margin-top:4px">Copy the message below and send it to us on Instagram. We usually reply within a day.</p>
      <div class="out" id="customOut" style="display:block;margin-top:12px"></div>
      <p style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap"><button class="btn" id="copyCustom" type="button">Copy message</button><a class="btn ghost" id="dmCustom" href="https://ig.me/m/panigacraftz_neha">Open Instagram DM</a><button class="btn ghost" id="coRestart" type="button">Start again</button></p>
    </div>
  </div>
</div></section>

<section class="band about" id="about"><div class="wrap maker">
  <div class="maker-pics">
    <img src="/images/planters/CVEi430hYq_.jpg" alt="A decoupage planter by Neha" loading="lazy">
    <img src="/images/planters/CYWFXeIFDyK.jpg" alt="Decoupage planters on a table" loading="lazy">
  </div>
  <div>
    <span class="hand">Meet the maker</span><h2>Made by hand, at home in Sydney</h2>
    <p class="lead">PanigaCraftz is Neha Koolwal's craft studio. A former lecturer, she started the business six years ago and loves giving colour to plain products.</p>
    <p class="lead">Every piece is decorated by hand using decoupage: paper designs are cut out, layered onto glass, wood, metal or ceramic and sealed with varnish, so no two pieces are exactly the same.</p>
    <p class="sign">Neha</p>
    <p style="margin-top:22px"><a class="btn" href="https://www.instagram.com/panigacraftz_neha/">Follow @panigacraftz_neha</a></p>
  </div>
</div></section>

<section class="band" id="instagram"><div class="wrap">
  <div class="row-head"><div><span class="hand">Follow along</span><h2>From our Instagram</h2><p class="lead">Follow along for new pieces and behind-the-scenes reels.</p></div><a class="btn ghost" href="https://www.instagram.com/panigacraftz_neha/">@panigacraftz_neha</a></div>
  <div class="igstrip" id="igstrip">
    {IG_STRIP.map(x => (
      <a href={igPost(x.id, x.kind)} aria-label="Open Instagram post"><img src={`/images/planters/${x.id}.jpg`} alt="PanigaCraftz planter on Instagram" loading="lazy" />{x.kind === 'reel' && <span>Reel</span>}</a>
    ))}
  </div>
</div></section>

<dialog class="qview" id="qview" aria-labelledby="qName">
  <div class="qgrid">
    <div class="qimg" id="qImg"></div>
    <div class="qbody">
      <span id="qCat" style="color:var(--red-ink);font-weight:800;font-size:13px"></span>
      <h2 id="qName"></h2>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><span class="price" id="qPrice"></span><span id="qStatus"></span><span class="size" id="qSize"></span></div>
      <p id="qDesc" style="margin:0;color:var(--mute)"></p>
      <ul id="qList"></ul>
      <div class="pers" id="qPers">
        <label><span id="qPersLabel">Name to add</span> <span class="hint" id="qPersCount">(optional, up to 5 words)</span><textarea id="qPersText" rows="2" aria-describedby="qPersErr" placeholder="e.g. Ms Lee"></textarea></label>
        <span class="err" id="qPersErr" hidden></span>
        <div class="preview-name" id="qPersPreview" aria-live="polite"></div>
        <label>Packaging<select id="qPack"></select></label>
        <label>Gift note <span class="hint" id="qNoteCount">0 / 150</span><textarea id="qNote" rows="2" maxlength="150" placeholder="Thank you for a wonderful year!"></textarea></label>
      </div>
      <div class="tags" id="qTags"></div>
      <div class="qact"><div class="qty"><button id="qMinus" aria-label="One fewer">−</button><span id="qQty">1</span><button id="qPlus" aria-label="One more">+</button></div><button class="btn" id="qAdd">Add to enquiry</button></div>
      <p class="note" style="margin:0;display:flex;gap:14px"><a id="qPage" href="#">See full details</a><a id="qIg" href="#">View on Instagram</a></p>
    </div>
  </div>
  <div class="qtop"><button id="qClose" aria-label="Close quick view">×</button></div>
  <div class="qnav"><button id="qPrev" aria-label="Previous product">‹</button><button id="qNext" aria-label="Next product">›</button></div>
</dialog>
<div class="fpreview" id="fpreview" aria-label="Festival preview"><p>Festival preview (admin)</p><div id="fbuttons">{festButtons.map(([id, n]) => <button class="chip" data-fprev={id} aria-pressed="false">{n}</button>)}</div></div>
</Base>

<script>
  import '../scripts/home.js';
</script>
