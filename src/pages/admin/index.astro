---
/* Neha's admin page (REQ-D5). Plain HTML here; src/scripts/admin.js signs her in
   with Supabase and fills in the tables. What she can change is decided by the
   database (supabase/admin.sql), not by this page, so hiding the page is not the
   security: an account that isn't in the admins table sees and changes nothing. */
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Admin | PanigaCraftz</title>
<link rel="icon" href="/images/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,800&display=swap" rel="stylesheet">
</head>
<body class="admin">
<header><nav class="nav" aria-label="Admin">
  <a class="logo" href="/"><img src="/images/logo.png" alt="PanigaCraftz logo"><span>PanigaCraftz<small>Admin</small></span></a>
  <div class="ml-auto flex items-center gap-3"><span id="who" class="text-sm"></span><button class="btn ghost" id="signOut" hidden>Sign out</button></div>
</nav></header>

<main class="band"><div class="wrap">
  <p class="err" id="notConnected" hidden>Supabase isn't connected: add the keys to .env (see README) and rebuild.</p>

  <section id="signIn" hidden>
    <h1>Sign in</h1>
    <form id="signInForm" class="wizard grid gap-3 max-w-md mt-4">
      <label>Email<input name="email" type="email" autocomplete="username" required></label>
      <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
      <p class="err" id="signInErr" hidden></p>
      <button class="btn" type="submit">Sign in</button>
    </form>
  </section>

  <section id="noAccess" hidden>
    <h1>No admin access</h1>
    <p class="lead">This account isn't set up as an admin. Ask Abhi to add it (see README, "Admin access").</p>
  </section>

  <section id="panel" hidden>
    <div class="chips" role="tablist">
      <button class="chip" data-tab="products" aria-pressed="true">Products and stock</button>
      <button class="chip" data-tab="enquiries" aria-pressed="false">Enquiries <b id="newCount"></b></button>
    </div>

    <div id="tab-products">
      <div class="tools"><label>Find<br><input id="find" type="search" placeholder="Name or category"></label>
        <p class="note" style="margin:0 0 8px">Changes to price, stock and word limits show on the site straight away. Leave stock empty if you don't count it. Untick "On site" to hide a product.</p></div>
      <div class="admin-table-wrap"><table class="admin-table" id="products">
        <thead><tr><th>Product</th><th>Price $</th><th>Stock</th><th>Status</th><th>Personalise</th><th>Field label</th><th>Word limit</th><th>Hamper piece</th><th>On site</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </div>

    <div id="tab-enquiries" hidden>
      <p class="note">Newest first. Cancelling an enquiry puts its hamper pieces back in stock.</p>
      <div id="enquiries"></div>
    </div>
  </section>
</div></main>
<div class="toast" id="toast" role="status"></div>

<script>import '../../scripts/admin.js';</script>
</body>
</html>
