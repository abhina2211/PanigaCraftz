---
/* Shown for any address that has no page, including a product that was removed or hidden. */
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | PanigaCraftz" description="This page isn't here.">
  <section class="band"><div class="wrap">
    <h1>We couldn't find that page</h1>
    <p class="lead">The piece may have sold out or moved. Have a look at everything in the shop.</p>
    <p><a class="btn" href="/#shop">Browse the shop</a></p>
  </div></section>
</Base>
